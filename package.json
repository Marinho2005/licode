{
  "name": "licode-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:sandbox": "pnpm --filter @licode/sandbox dev",
    "dev:web": "pnpm --filter @licode/web dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "test": "node tests/acceptance.test.mjs"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@ruby/3.4-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "playwright": "1.63.0",
    "pyodide": "314.0.7",
    "typescript": "^5.8.2"
  }
}
